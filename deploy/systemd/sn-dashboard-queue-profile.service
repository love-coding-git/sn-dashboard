[Unit]
Description=Subnet Watch queue worker 'profile' - Taostats owner lookups, owner traces and earnings (slow: the Taostats rate limit)
After=network-online.target mysql.service
Wants=network-online.target

[Service]
User=deploy
Group=www-data
WorkingDirectory=/var/www/sn-dashboard
ExecStart=/usr/bin/php artisan queue:work --queue=resolve,owners,profile --sleep=3 --tries=3 --timeout=950 --max-time=3600
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

# Subnet Watch - production settings for dashboard.reservakit.com (copied to .env by deploy/provision.sh).
# Fill in: TAO_API_KEY and DASHBOARD_ADMIN_EMAIL / DASHBOARD_ADMIN_PASSWORD. DB_PASSWORD is generated by provision.sh,
# APP_KEY by update.sh. Never commit the filled-in file.

APP_NAME="Subnet Watch"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://dashboard.reservakit.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sn_dashboard
DB_USERNAME=sn_dashboard
DB_PASSWORD=

SESSION_DRIVER=database
# a signed-in browser stays signed in for 30 days
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"

# Login: every page needs the app's login; the one account is written by `php artisan dashboard:admin` (update.sh runs it).
DASHBOARD_REQUIRE_LOGIN=true
DASHBOARD_ADMIN_NAME=admin
DASHBOARD_ADMIN_EMAIL=
DASHBOARD_ADMIN_PASSWORD=
DASHBOARD_ALLOW_REGISTRATION=false

# Taostats API (metagraphs, owner tracing, earnings). 5 calls a minute on the free tier.
TAO_API_KEY=

# The Yugos Discord channel (#34 mind) is read every minute with this user token (read only; against Discord's terms for
# user accounts - the account carries that risk). Empty: the Discord tab is not updated.
DISCORD_USER_TOKEN=

# The SOMA competition shown as "now" (the leaderboard and the round page).
SOMA_COMPETITION=151
